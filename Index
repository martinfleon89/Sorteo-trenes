<!DOCTYPE html>
<html lang="es" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>KnNi - Mesa Redonda y Sorteos</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');
        body { 
            font-family: 'Inter', sans-serif; 
            background-color: #0c120e; 
            background-image: radial-gradient(circle at 50% 0%, #152219 0%, #0c120e 70%);
            color: #d6d3d1;
        }
        .font-cinzel { font-family: 'Cinzel', serif; }
        .card-glass {
            background: linear-gradient(145deg, rgba(22, 33, 24, 0.85), rgba(12, 18, 14, 0.95));
            backdrop-filter: blur(12px);
            border: 1px solid rgba(63, 98, 56, 0.3);
            box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.7);
        }
        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #0c120e; }
        ::-webkit-scrollbar-thumb { background: #2f4532; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #3f5f45; }
        .tab-btn.active {
            background-color: #1a2e20;
            color: #fbbf24;
            border: 1px solid rgba(251, 191, 36, 0.3);
            box-shadow: 0 4px 10px -1px rgba(0, 0, 0, 0.3);
        }
        .tab-btn:not(.active) { color: #a8a29e; border: 1px solid transparent; }
        .tab-btn:not(.active):hover { color: #ffffff; background-color: #152419; }
        thead { background: rgba(12, 18, 14, 0.95); }
        tr:hover { background-color: rgba(30, 45, 33, 0.5) !important; }
    </style>
</head>
<body class="flex flex-col selection:bg-green-800 selection:text-yellow-400 min-h-screen">

    <!-- Top Navigation Bar -->
    <header class="sticky top-0 z-50 border-b border-green-900/50 bg-[#0c120e]/90 backdrop-blur-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-yellow-600 to-yellow-800 border border-yellow-500/50 flex items-center justify-center shadow-[0_0_15px_rgba(202,138,4,0.3)] text-stone-100 text-xl">
                    <i class="fa-solid fa-shield"></i>
                </div>
                <div>
                    <h1 class="font-cinzel font-bold text-lg tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 via-yellow-500 to-yellow-700" data-i18n="title">
                        KnNi MESA REDONDA
                    </h1>
                    <p class="text-xs text-stone-400" data-i18n="subtitle">Tablero de Alianza y Sorteos</p>
                </div>
            </div>
            
            <nav class="hidden md:flex space-x-1 bg-[#101712] p-1 rounded-xl border border-green-900/40">
                <button onclick="switchTab('dashboard')" id="btn-dashboard" class="tab-btn active px-4 py-2 rounded-lg text-sm font-semibold transition-all">
                    <i class="fa-solid fa-scroll mr-2"></i><span data-i18n="tabDashboard">Reino</span>
                </button>
                <button onclick="switchTab('giveaway')" id="btn-giveaway" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all">
                    <i class="fa-solid fa-dice-d20 mr-2"></i><span data-i18n="tabGiveaway">Sorteo Divino</span>
                </button>
                <button onclick="switchTab('history')" id="btn-history" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all">
                    <i class="fa-solid fa-book-journal-whills mr-2"></i><span data-i18n="tabHistory">Crónicas</span>
                </button>
                <button onclick="switchTab('alliance')" id="btn-alliance" class="tab-btn px-4 py-2 rounded-lg text-sm font-semibold transition-all">
                    <i class="fa-solid fa-chess-knight mr-2"></i><span data-i18n="tabAlliance">Batallón</span>
                </button>
            </nav>

            <div class="flex items-center space-x-4">
                <button onclick="toggleLang()" class="px-2.5 py-1 bg-green-900/40 border border-green-700/50 rounded hover:bg-green-800 transition-colors text-xs font-bold text-yellow-500 font-cinzel">
                    <span id="lang-ind">ES</span> <i class="fa-solid fa-language ml-1"></i>
                </button>
                <div class="hidden sm:flex flex-col text-right">
                    <span class="text-xs font-semibold text-yellow-500 font-cinzel" data-i18n="era">Era Actual</span>
                    <span class="text-xs text-stone-400" id="current-date">...</span>
                </div>
                <div class="md:hidden">
                    <button onclick="toggleMobileMenu()" class="p-2 rounded-lg bg-[#101712] text-stone-300 hover:text-white border border-green-900/40">
                        <i class="fa-solid fa-bars text-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden px-4 pt-2 pb-4 space-y-1 bg-[#0c120e] border-b border-green-900/50">
            <button onclick="switchTab('dashboard'); toggleMobileMenu();" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-yellow-500" data-i18n="tabDashboard">Reino</button>
            <button onclick="switchTab('giveaway'); toggleMobileMenu();" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-stone-300" data-i18n="tabGiveaway">Sorteo Divino</button>
            <button onclick="switchTab('history'); toggleMobileMenu();" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-stone-300" data-i18n="tabHistory">Crónicas</button>
            <button onclick="switchTab('alliance'); toggleMobileMenu();" class="w-full text-left px-3 py-2 rounded-md text-sm font-medium text-stone-300" data-i18n="tabAlliance">Batallón</button>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

        <!-- TAB 1: DASHBOARD -->
        <div id="tab-dashboard" class="space-y-8">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="card-glass p-5 rounded-xl relative overflow-hidden group hover:border-yellow-600/50 transition-all">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-widest font-cinzel" data-i18n="force">Fuerza Aliada</p>
                            <h3 class="text-3xl font-bold font-cinzel text-stone-100 mt-1">100</h3>
                        </div>
                        <div class="w-12 h-12 rounded-lg bg-green-900/40 border border-green-700/30 flex items-center justify-center text-green-500 text-xl"><i class="fa-solid fa-users"></i></div>
                    </div>
                </div>

                <div class="card-glass p-5 rounded-xl relative overflow-hidden group hover:border-yellow-600/50 transition-all">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-widest font-cinzel" data-i18n="campaigns">Campañas</p>
                            <h3 id="stat-total-draws" class="text-3xl font-bold font-cinzel text-stone-100 mt-1">0</h3>
                        </div>
                        <div class="w-12 h-12 rounded-lg bg-stone-800/40 border border-stone-600/30 flex items-center justify-center text-stone-400 text-xl"><i class="fa-solid fa-map-location-dot"></i></div>
                    </div>
                </div>

                <div class="card-glass p-5 rounded-xl relative overflow-hidden group hover:border-yellow-600/50 transition-all">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-widest font-cinzel" data-i18n="lastKnight">Último Caballero</p>
                            <h3 id="stat-last-driver" class="text-xl font-bold font-cinzel text-green-400 mt-1 truncate max-w-[150px]">---</h3>
                        </div>
                        <div class="w-12 h-12 rounded-lg bg-green-900/30 border border-green-600/30 flex items-center justify-center text-green-500 text-xl"><i class="fa-solid fa-horse-head"></i></div>
                    </div>
                </div>

                <div class="card-glass p-5 rounded-xl relative overflow-hidden group hover:border-yellow-600/50 transition-all">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-[10px] font-bold text-stone-400 uppercase tracking-widest font-cinzel" data-i18n="lastLord">Último Lord VIP</p>
                            <h3 id="stat-last-vip" class="text-xl font-bold font-cinzel text-yellow-500 mt-1 truncate max-w-[150px]">---</h3>
                        </div>
                        <div class="w-12 h-12 rounded-lg bg-yellow-900/30 border border-yellow-600/30 flex items-center justify-center text-yellow-500 text-xl"><i class="fa-solid fa-crown"></i></div>
                    </div>
                </div>
            </div>

            <!-- SALON DE MVPS -->
            <div class="card-glass p-6 rounded-xl border-t-2 border-t-yellow-600">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="font-cinzel font-bold text-lg text-yellow-500" data-i18n="mvpHallTitle">Salón de Honor y MVPs</h3>
                        <p class="text-xs text-stone-400" data-i18n="mvpHallSub">Reconocimientos de la semana y batallas especiales</p>
                    </div>
                    <button onclick="openMvpModal()" class="px-3 py-1.5 bg-yellow-900/40 border border-yellow-600/50 text-yellow-400 rounded-lg text-xs font-bold font-cinzel hover:bg-yellow-800 transition-colors">
                        <i class="fa-solid fa-pen-to-square mr-1"></i> <span data-i18n="editMvpsBtn">Editar MVPs</span>
                    </button>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-[#090d0a] border border-green-900/50 rounded-lg p-4 text-center">
                        <p class="text-[10px] text-yellow-500 uppercase font-bold tracking-widest mb-1 font-cinzel">⭐ <span data-i18n="weeklyMvp">MVP & Campeón Semanal</span></p>
                        <p id="mvp-weekly" class="text-sm font-bold text-stone-200 mt-1 truncate">B1G BOSS</p>
                        <p id="champ-weekly" class="text-xs text-stone-400 mt-0.5 truncate">Camp: 낭만용사Maquina</p>
                    </div>
                    <div class="bg-[#090d0a] border border-green-900/50 rounded-lg p-4 text-center">
                        <p class="text-[10px] text-orange-400 uppercase font-bold tracking-widest mb-1 font-cinzel">☀️ <span data-i18n="desertMvp">MVP Desert Storm</span></p>
                        <p id="mvp-desert-1" class="text-sm font-bold text-stone-200 mt-1 truncate">---</p>
                        <p id="mvp-desert-2" class="text-xs text-stone-400 mt-0.5 truncate">---</p>
                    </div>
                    <div class="bg-[#090d0a] border border-green-900/50 rounded-lg p-4 text-center">
                        <p class="text-[10px] text-blue-400 uppercase font-bold tracking-widest mb-1 font-cinzel">🎯 <span data-i18n="cannonMvp">MVP Cañón Storm</span></p>
                        <p id="mvp-cannon-1" class="text-sm font-bold text-stone-200 mt-1 truncate">---</p>
                        <p id="mvp-cannon-2" class="text-xs text-stone-400 mt-0.5 truncate">---</p>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Top Drivers Chart -->
                <div class="card-glass p-6 rounded-xl flex flex-col justify-between">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h3 class="font-cinzel font-bold text-lg text-yellow-500" data-i18n="hallOfFame">Salón de la Fama (Caballeros)</h3>
                            <p class="text-xs text-stone-400" data-i18n="hallSubtitle">Guerreros con más campañas lideradas</p>
                        </div>
                    </div>
                    <div class="relative h-72 w-full"><canvas id="topDriversChart"></canvas></div>
                </div>

                <!-- Last 5 Draws -->
                <div class="card-glass p-6 rounded-xl flex flex-col justify-between">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-cinzel font-bold text-lg text-yellow-500 flex items-center">
                            <i class="fa-solid fa-hourglass-half mr-2"></i> <span data-i18n="recentDraws">Últimas Gestas</span>
                        </h3>
                        <button onclick="switchTab('history')" class="text-xs text-yellow-600 hover:text-yellow-400 hover:underline" data-i18n="openChronicles">Abrir Crónicas &rarr;</button>
                    </div>
                    <div class="overflow-y-auto max-h-72">
                        <table class="w-full text-left text-sm text-stone-300">
                            <thead class="text-[10px] uppercase text-stone-500 border-b border-green-900/50 sticky top-0 font-cinzel tracking-wider">
                                <tr>
                                    <th class="px-4 py-3" data-i18n="day">Día</th>
                                    <th class="px-4 py-3" data-i18n="knight">Caballero (Driver)</th>
                                    <th class="px-4 py-3" data-i18n="lord">Lord (VIP)</th>
                                </tr>
                            </thead>
                            <tbody id="recent-history-tbody" class="divide-y divide-green-900/30">
                                <!-- JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: SORTEADOR -->
        <div id="tab-giveaway" class="hidden space-y-6">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <div class="card-glass p-6 rounded-xl lg:col-span-4 flex flex-col h-full border-t-2 border-t-green-700">
                    <h2 class="font-cinzel font-bold text-xl text-yellow-500 mb-1" data-i18n="summonTroopsTitle">1. Convocar Tropa</h2>
                    <p class="text-xs text-stone-400 mb-4" data-i18n="summonTroopsSub">Ingresa los nombres de los valientes. El sello mágico bloqueará a quienes hayan ganado en las últimas 14 gestas.</p>
                    
                    <textarea id="bulk-names" rows="10" class="w-full flex-1 bg-[#090d0a] border border-green-900/50 rounded-lg p-4 text-sm text-stone-200 focus:border-yellow-600 outline-none resize-none transition-colors mb-4 placeholder-stone-600"></textarea>
                    
                    <button onclick="loadParticipants()" class="w-full py-4 bg-green-900/80 text-yellow-500 font-bold rounded-lg shadow-lg hover:bg-green-800 border border-green-700 transition-all font-cinzel tracking-widest">
                        <i class="fa-solid fa-wand-magic-sparkles mr-2"></i> <span data-i18n="sealList">SELLAR LISTA</span>
                    </button>
                </div>

                <div class="lg:col-span-8 space-y-6">
                    <div class="card-glass p-6 rounded-xl flex flex-col items-center justify-center text-center relative overflow-hidden min-h-[300px]">
                        <div class="w-full flex justify-between px-4 mb-4 z-10">
                            <div class="text-left bg-[#090d0a] border border-green-900/50 rounded-lg p-3 min-w-[120px]">
                                <p class="text-[10px] text-stone-500 uppercase font-bold tracking-widest mb-1 font-cinzel" data-i18n="aptKnight">Aptos (Caballero)</p>
                                <p id="count-driver" class="text-xl font-cinzel font-bold text-green-500">0</p>
                            </div>
                            <div class="text-right bg-[#090d0a] border border-green-900/50 rounded-lg p-3 min-w-[120px]">
                                <p class="text-[10px] text-stone-500 uppercase font-bold tracking-widest mb-1 font-cinzel" data-i18n="aptLord">Aptos (Lord VIP)</p>
                                <p id="count-vip" class="text-xl font-cinzel font-bold text-yellow-500">0</p>
                            </div>
                        </div>

                        <div id="roulette-box" class="w-full max-w-lg py-10 px-6 rounded-2xl bg-[#070a08] border-2 border-green-900/60 relative my-4 z-10 transition-all duration-300">
                            <p id="draw-type-label" class="text-xs text-yellow-600/70 uppercase tracking-widest mb-3 font-cinzel hidden" data-i18n="chosen">El Elegido</p>
                            <h3 id="winner-display" class="font-cinzel font-extrabold text-3xl sm:text-5xl text-stone-600 min-h-[4rem] flex items-center justify-center drop-shadow-md">
                                ...
                            </h3>
                        </div>

                        <div class="grid grid-cols-2 gap-4 w-full max-w-lg z-10">
                            <button onclick="startDraw('Driver')" id="btn-draw-driver" disabled class="py-4 bg-green-900/30 text-green-500 border border-green-700/50 hover:bg-green-800 hover:text-white font-bold rounded-lg transition-all disabled:opacity-30 disabled:cursor-not-allowed font-cinzel">
                                <i class="fa-solid fa-horse-head mr-2"></i> <span data-i18n="drawKnight">Elegir CABALLERO</span>
                            </button>
                            <button onclick="startDraw('VIP')" id="btn-draw-vip" disabled class="py-4 bg-yellow-900/30 text-yellow-500 border border-yellow-700/50 hover:bg-yellow-800 hover:text-white font-bold rounded-lg transition-all disabled:opacity-30 disabled:cursor-not-allowed font-cinzel">
                                <i class="fa-solid fa-crown mr-2"></i> <span data-i18n="drawLord">Elegir LORD VIP</span>
                            </button>
                        </div>
                        
                        <button onclick="saveToHistory()" id="btn-save" class="w-full max-w-lg mt-4 py-3 bg-gradient-to-r from-yellow-700 to-yellow-600 text-stone-100 font-bold rounded-lg shadow-[0_0_15px_rgba(202,138,4,0.4)] hover:from-yellow-600 hover:to-yellow-500 transition-all hidden z-10 font-cinzel tracking-widest border border-yellow-400/50">
                            <i class="fa-solid fa-feather-pointed mr-2"></i> <span data-i18n="writeChronicles">Escribir en las Crónicas</span>
                        </button>
                    </div>

                    <div class="card-glass p-6 rounded-xl">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-cinzel font-bold text-lg text-yellow-500" data-i18n="battalionState">Estado del Batallón</h3>
                            <span id="valid-count" class="px-3 py-1 bg-[#090d0a] text-stone-400 rounded-lg text-xs font-bold border border-green-900/50 font-cinzel">0</span>
                        </div>
                        <div id="status-list" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 max-h-48 overflow-y-auto pr-2">
                            <p class="text-sm text-stone-500 col-span-full" data-i18n="summonLeft">Convoca la tropa en el pergamino izquierdo.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: HISTORIAL -->
        <div id="tab-history" class="hidden space-y-6">
            <!-- AGREGAR CRÓNICA MANUAL -->
            <div class="card-glass p-6 rounded-xl border-t-2 border-t-amber-500">
                <h2 class="font-cinzel font-bold text-lg text-yellow-500 mb-2" data-i18n="manualRecordTitle">Agregar Crónica Manualmente</h2>
                <p class="text-xs text-stone-400 mb-4" data-i18n="manualRecordSub">Ingresa un registro pasado o directo al historial.</p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
                    <div>
                        <label class="block text-xs text-stone-400 font-cinzel uppercase mb-1" data-i18n="day">Fecha</label>
                        <input type="date" id="manual-date" class="w-full bg-[#090d0a] border border-green-900/50 rounded-lg p-2.5 text-sm text-stone-200 focus:border-yellow-600 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs text-stone-400 font-cinzel uppercase mb-1" data-i18n="knight">Caballero (Driver)</label>
                        <input type="text" id="manual-driver" placeholder="Nombre del Driver" class="w-full bg-[#090d0a] border border-green-900/50 rounded-lg p-2.5 text-sm text-stone-200 focus:border-yellow-600 outline-none placeholder-stone-600">
                    </div>
                    <div>
                        <label class="block text-xs text-stone-400 font-cinzel uppercase mb-1" data-i18n="lord">Lord (VIP)</label>
                        <input type="text" id="manual-vip" placeholder="Nombre del VIP" class="w-full bg-[#090d0a] border border-green-900/50 rounded-lg p-2.5 text-sm text-stone-200 focus:border-yellow-600 outline-none placeholder-stone-600">
                    </div>
                </div>
                <button onclick="addManualRecord()" class="py-2.5 px-6 bg-yellow-700 hover:bg-yellow-600 text-stone-100 font-bold rounded-lg text-sm font-cinzel border border-yellow-500/50 transition-all shadow-[0_0_10px_rgba(202,138,4,0.3)]">
                    <i class="fa-solid fa-plus mr-2"></i> <span data-i18n="addToHistoryBtn">Añadir al Historial</span>
                </button>
            </div>

            <!-- TABLA DE CRÓNICAS -->
            <div class="card-glass p-6 rounded-xl border-t-2 border-t-yellow-700">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="font-cinzel font-bold text-xl text-yellow-500" data-i18n="chroniclesTitle">Las Crónicas (Historial)</h2>
                        <p class="text-xs text-stone-400" data-i18n="chroniclesSub">Los últimos 14 registros bloquean a los guerreros de nuevas campañas.</p>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-stone-500"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" id="search-history" onkeyup="filterHistory()" class="w-full sm:w-72 pl-10 pr-4 py-2 bg-[#090d0a] border border-green-900/50 rounded-lg text-sm text-stone-200 focus:border-yellow-600 outline-none transition-all placeholder-stone-600">
                    </div>
                </div>

                <div class="overflow-x-auto rounded-lg border border-green-900/40">
                    <table class="w-full text-left text-sm text-stone-300">
                        <thead class="text-xs uppercase bg-[#090d0a] text-stone-400 border-b border-green-900/50 font-cinzel tracking-wider">
                            <tr>
                                <th class="px-6 py-4">#</th>
                                <th class="px-6 py-4" data-i18n="day">Día</th>
                                <th class="px-6 py-4" data-i18n="knight">Caballero (Driver)</th>
                                <th class="px-6 py-4" data-i18n="lord">Lord (VIP)</th>
                                <th class="px-6 py-4 text-center" data-i18n="actions">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="full-history-tbody" class="divide-y divide-green-900/30">
                            <!-- JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 4: ALIANZA -->
        <div id="tab-alliance" class="hidden space-y-6">
            <div class="card-glass p-6 rounded-xl border-t-2 border-t-stone-500">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
                    <div>
                        <h2 class="font-cinzel font-bold text-xl text-stone-100" data-i18n="allianceTitle">Batallón de la Alianza KnNi</h2>
                        <p class="text-xs text-stone-400" data-i18n="allianceSub">Listado histórico de los 100 guerreros.</p>
                    </div>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-stone-500"><i class="fa-solid fa-magnifying-glass"></i></span>
